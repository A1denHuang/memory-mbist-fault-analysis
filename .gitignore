# Published evidence is an allowlist. Raw cases, probes, labels and predictions
# are regenerated locally and uploaded by CI, never committed.
/results/*
!/results/report.md
!/results/verification.json
!/results/blind_metrics.json
!/results/blind_confusion.csv
!/results/fault_element_coverage.csv
!/results/functional_coverage.json
!/results/coupling_order_coverage.json
!/results/delivery_audit.json
!/results/mutation_report.json
!/results/figures/
/results/figures/*
!/results/figures/*.png
!/results/followup/
/results/followup/*
!/results/followup/report.md
!/results/followup/metrics.json

/results_questa/*
!/results_questa/report.md
!/results_questa/verification.json
!/results_questa/blind_metrics.json
!/results_questa/blind_confusion.csv
!/results_questa/fault_element_coverage.csv
